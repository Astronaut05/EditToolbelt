# Every environment variable the apps read. Names only: real values come from the
# host's secret store (docs/11-security.md). compose.yaml sets local values.
# Validation: packages/core/src/env.ts (web) and apps/worker/src/etb_worker/settings.py.

# --- shared -----------------------------------------------------------------
# local | test | staging | production (default: local)
APP_ENV=
# Commit SHA or release tag, set by CI (default: dev)
APP_VERSION=
# debug | info | warn | error (default: info; debug is refused in production)
LOG_LEVEL=

# --- web (apps/web) ---------------------------------------------------------
# No domain or host is hard-coded in the code; these two decide every URL.
# Origin for canonical, sitemap, OG, JSON-LD and robots.txt URLs
# (default: http://localhost:3000; must be the public origin in staging/production)
SITE_URL=
# Where model and WASM files load from: a root-relative path or an http(s) URL
# (default: /models, i.e. apps/web/public/models, not committed)
MODELS_BASE_URL=
# Cookieless analytics: base URL of a self-hosted Umami-compatible collector and
# the site's id there. Leave both empty to send nothing (the default).
ANALYTICS_URL=
ANALYTICS_WEBSITE_ID=

# --- web, server build (ETB_TARGET=server: the local stack, production from M5)
# server = the site plus accounts, admin and API; unset = the static export
ETB_TARGET=
# Signs sessions and encrypts TOTP secrets: 32+ random characters, one per environment
BETTER_AUTH_SECRET=
# Google sign-in: both, or neither (then there's no Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in email: smtp://host:port or smtps://user:pass@host:465 (the stack uses Mailpit)
SMTP_URL=
# From address (default: no-reply@ the SITE_URL host)
MAIL_FROM=
# local and test only: write each email as a JSON file here instead of sending it
MAIL_OUTBOX_DIR=
# Optional: only these client IPs, comma-separated, reach /admin (read from
# Cloudflare's CF-Connecting-IP, else X-Forwarded-For); anyone else gets a 404
ADMIN_IP_ALLOWLIST=
# The welcome grant after email verification (default: true). false stops it at once.
WELCOME_GRANT_ENABLED=
# Keys the welcome-grant claims (32+ characters, long-lived). Unset: derived
# from BETTER_AUTH_SECRET; set this before ever rotating that one.
WELCOME_GRANT_SECRET=

# --- payments (docs/05 → Payments; docs/runbooks/turn-on-payments.md) --------
# The kill switch (default: false). Nothing is sold unless this is true, an
# admin switched the provider on in Admin → Payments, and its keys are set.
PAYMENTS_ENABLED=
# Paddle (worldwide, USD): API key, notification secret, sandbox|production,
# and the client-side token for Paddle.js on /credits/buy
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=
PADDLE_CLIENT_TOKEN=
# Click (Uzbekistan, UZS): from Click's merchant cabinet
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Payme (Uzbekistan, UZS): the cashbox id, its key, and true for Payme's test checkout
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=
# Tests only (APP_ENV=test): a stand-in for one provider (paddle, click or payme)
# and the key its webhook takes. The server e2e tests set both.
PAYMENTS_STUB=
PAYMENTS_STUB_KEY=

# --- server processes (worker, and the web's server build) -------------------
# postgres:// or postgresql:// URL. `pnpm db:migrate` applies migrations to it.
DATABASE_URL=
# A separate, throwaway Postgres 18 database for packages/db's integration
# tests (they write rows that can never be deleted). Unset: those tests skip.
TEST_DATABASE_URL=
# S3-compatible endpoint (R2 in staging/production)
S3_ENDPOINT=
# auto for R2 (default: auto)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# web server build: where browsers reach storage for presigned upload and
# download URLs, when the server reaches it by another name (the stack: the
# server uses http://storage:7070, browsers http://localhost:7070). Default: S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
# Storage for the server build's end-to-end tests (default: http://127.0.0.1:7070,
# the stack's; they use their own `etb-test` bucket)
TEST_S3_ENDPOINT=

# --- worker: jobs -------------------------------------------------------------
# Jobs one worker runs at once, one ffmpeg process each (default: 1)
WORKER_SLOTS=

# --- worker: alerts and the daily digest (docs/07 → Alerts) ------------------
# Telegram first, email as backup; with neither, alerts are only logged and
# listed in the admin's System page. SMTP_URL and MAIL_FROM are the same names
# as the web's (above).
# A private bot's token (from @BotFather) and the chat it writes to: both, or neither
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tests only: a stand-in for Telegram's Bot API (default: the real one)
TELEGRAM_API_URL=
# Where alert and digest emails go (needs SMTP_URL and MAIL_FROM)
ALERT_EMAIL=

# --- compose only: host ports (defaults 3000 / 5432 / 7070 / 8025) -----------
ETB_WEB_PORT=
ETB_MAIL_PORT=
ETB_POSTGRES_PORT=
ETB_STORAGE_PORT=
