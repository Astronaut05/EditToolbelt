# Every environment variable the apps read. Names only: real values come from the
# host's secret store (docs/11-security.md). compose.yaml sets local values.
# Validation: packages/core/src/env.ts (web) and apps/worker/src/etb_worker/settings.py.

# --- shared -----------------------------------------------------------------
# local | test | staging | production (default: local)
APP_ENV=
# Commit SHA or release tag, set by CI (default: dev)
APP_VERSION=
# debug | info | warn | error (default: info; debug is refused in production)
LOG_LEVEL=

# --- web (apps/web) ---------------------------------------------------------
# No domain or host is hard-coded in the code; these two decide every URL.
# Origin for canonical, sitemap, OG, JSON-LD and robots.txt URLs
# (default: http://localhost:3000; must be the public origin in staging/production)
SITE_URL=
# Where model and WASM files load from: a root-relative path or an http(s) URL
# (default: /models, i.e. apps/web/public/models, not committed)
MODELS_BASE_URL=
# Cookieless analytics: base URL of a self-hosted Umami-compatible collector and
# the site's id there. Leave both empty to send nothing (the default).
ANALYTICS_URL=
ANALYTICS_WEBSITE_ID=

# --- server processes (worker now, web server routes from M3) ---------------
# postgres:// or postgresql:// URL
DATABASE_URL=
# S3-compatible endpoint (R2 in staging/production)
S3_ENDPOINT=
# auto for R2 (default: auto)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- compose only: host ports (defaults 3000 / 5432 / 7070) ------------------
ETB_WEB_PORT=
ETB_POSTGRES_PORT=
ETB_STORAGE_PORT=
