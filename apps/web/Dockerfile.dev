# Local development image for apps/web (next dev with hot reload). Build context: repo root.
# Production is a static export on Cloudflare Pages; there is no production web image until M5.
# The compose `migrate` service runs this image too, for `pnpm db:migrate`.
FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

ENV NEXT_TELEMETRY_DISABLED=1 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1

RUN corepack enable

WORKDIR /repo
# Whole repo (minus .dockerignore). compose watch rebuilds this image when a
# manifest or the lockfile changes, and syncs source files in place otherwise.
COPY . .
RUN pnpm install --frozen-lockfile --filter @etb/web... --filter @etb/db...

EXPOSE 3000
CMD ["pnpm", "--filter", "@etb/web", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
