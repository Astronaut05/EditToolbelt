{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalPassThroughEnv": ["CI", "NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "APP_ENV",
        "APP_VERSION",
        "LOG_LEVEL",
        "SITE_URL",
        "MODELS_BASE_URL",
        "ETB_WORKSHOP",
        "ANALYTICS_URL",
        "ANALYTICS_WEBSITE_ID"
      ],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
